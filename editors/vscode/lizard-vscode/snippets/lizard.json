{
  "Function": {
    "prefix": "fn",
    "body": ["fn ${1:functionName}(${2:parameters})", "    $0", "end"],
    "description": "Define a LIZARD function"
  },
  "If": {
    "prefix": "if",
    "body": ["if ${1:condition}", "    $0", "end"],
    "description": "Create an if block"
  },
  "If Else": {
    "prefix": "ifelse",
    "body": ["if ${1:condition}", "    $2", "else", "    $0", "end"],
    "description": "Create an if/else block"
  },
  "Each": {
    "prefix": "each",
    "body": ["each ${1:item} in ${2:items}", "    $0", "end"],
    "description": "Iterate over a LIZARD collection"
  },
  "Repeat": {
    "prefix": "repeat",
    "body": ["repeat ${1:count}", "    $0", "end"],
    "description": "Repeat a LIZARD block"
  }
}
